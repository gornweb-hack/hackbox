# Локальные настройки, необязательно. Остальное задано в docker-compose.yml.
# Скопируйте в .env, если нужно что-то поменять.

# Порт Postgres на localhost — если 5432 уже занят другим проектом
POSTGRES_PORT=5432

# Порт ядра на localhost — если 4000 уже занят
CORE_PORT=4000

# Порт Redis на localhost — если 6379 уже занят
REDIS_PORT=6379
