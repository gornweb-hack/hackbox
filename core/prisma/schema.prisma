// Схема ядра (public): пользователи и их сессии. Данные модулей живут в их собственных схемах.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  // Явно: иначе Prisma угадывает по tsconfig, а в Docker его нет на момент генерации
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  MANAGER
  ADMIN

  @@map("user_role")
}

model User {
  id            String         @id @default(uuid(7)) @db.Uuid
  // Табельный номер, телефон или email — любая уникальная строка, хранится в нижнем регистре
  login         String         @unique
  name          String
  email         String?        @unique
  passwordHash  String         @map("password_hash")
  role          Role           @default(USER)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  refreshTokens RefreshToken[]

  @@map("users")
}

// Refresh-токены: храним только хэш, сам токен знает лишь клиент
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- gamification: опыт, уровни, ачивки, рейтинг ----------

// Журнал прохождений — копия данных из scenario.completed. Опыт, уровень, репутация,
// очки компетенций и рейтинг считаются из него при запросе, поэтому правка правил в YAML
// сразу пересчитывает всех
model GamificationRun {
  id           String   @id @default(uuid(7)) @db.Uuid
  // Уникальность отсекает повторную доставку события
  runId        String   @unique @map("run_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  scenarioId   String   @map("scenario_id")
  category     String
  outcome      String
  loyalty      Int
  safety       Int
  timeouts     Int
  // Очки по компетенциям за прохождение: {"acknowledge": 20, "safety": 15}
  competencies Json
  // Время из события, а не время записи: по нему считаются тренд за неделю и окно челленджа
  completedAt  DateTime @map("completed_at") @db.Timestamptz(3)

  @@index([userId, completedAt])
  @@map("gamification_runs")
}

// Полученные ачивки хранятся, а не вычисляются: после правки порога в YAML они не пропадают,
// а вставка показывает, что ачивка новая и о ней нужно уведомить один раз
model GamificationAchievement {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  // id ачивки из YAML
  achievementId String   @map("achievement_id")
  earnedAt      DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)

  @@unique([userId, achievementId])
  @@map("gamification_achievements")
}
