# Для запуска ядра без Docker (npm run start:dev). Скопируйте в core/.env.
# Порт базы — как POSTGRES_PORT в корневом .env (по умолчанию 5432)
DATABASE_URL=postgres://core_svc:core_pass@localhost:5432/app

# Вход пользователей
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
REGISTRATION_OPEN=false
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
SEED_DEMO_USERS=true

# События (Redis)
REDIS_URL=redis://:redis_pass@localhost:6379
EVENTS_RETRY_MS=30000
