# Для запуска ядра без Docker (npm run start:dev). Скопируйте в core/.env.
# Порт базы — как POSTGRES_PORT в корневом .env (по умолчанию 5432)
DATABASE_URL=postgres://core_svc:core_pass@localhost:5432/app
MODULES=tpl_go,tpl_py
# Модули, запущенные у вас на хосте, — по порту из таблицы в docs/module-contract.md
MODULE_URL_TPL_GO=http://localhost:8101
MODULE_URL_TPL_PY=http://localhost:8102
